{
  "name": "Sputnik-Dev",
  "main": "index.html",
  "version": "2.0.0",
  "scripts": {
    "build:windows": "node ../scripts/build-windows.js",
    "test": "node --test ../spec/security/articleHtml.test.js ../spec/integration/feedsAndArticles.test.js",
    "test:security": "node --test ../spec/security/articleHtml.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "webkit": {
    "plugin": false
  },
  "window": {
    "icon": "visual/icon.png",
    "show": true,
    "toolbar": true,
    "width": 1000,
    "height": 660,
    "position": "center",
    "min_width": 800,
    "min_height": 400
  },
  "dependencies": {
    "@seald-io/nedb": "4.1.2",
    "axios": "1.21.1",
    "cheerio": "1.2.0",
    "feedparser": "2.6.1",
    "htm": "3.1.1",
    "iconv-lite": "0.7.3",
    "preact": "11.2.0",
    "q": "1.5.1",
    "sanitize-html": "2.18.2",
    "xmlbuilder": "15.1.1",
    "xmldoc": "3.0.0"
  },
  "devDependencies": {
    "nw-builder": "4.25.0",
    "preact-render-to-string": "6.8.3"
  },
  "nwbuild": {
    "version": "0.120.0",
    "platform": "win",
    "arch": "x64",
    "flavor": "normal",
    "app": {
      "name": "Sputnik",
      "icon": "../src/graphics/icon.ico",
      "company": "Sputnik Project",
      "fileDescription": "Sputnik RSS and Atom Reader",
      "fileVersion": "2.0.0",
      "internalName": "Sputnik",
      "legalCopyright": "Copyright (C) 2013 Jakub Szwacz",
      "originalFilename": "Sputnik.exe",
      "productName": "Sputnik",
      "productVersion": "2.0.0"
    },
    "nsis": {
      "appId": "org.dz0ny.sputnik",
      "desktopShortcut": true,
      "startMenuShortcut": true
    }
  }
}
